<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Odoo 19 groups hang off a "privilege" (the row a user's access form
         shows), not straight off an app category. Filed under Sales, which is
         where affiliate orders live. -->
    <record id="res_groups_privilege_cybervilla_affiliate" model="res.groups.privilege">
        <field name="name">CyberVilla Affiliate</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>

    <!-- Who may see and manage the affiliate registry, links and payouts feed
         inside Odoo. The integration user works through its Sales rights. -->
    <record id="group_cybervilla_affiliate_manager" model="res.groups">
        <field name="name">Affiliate Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_cybervilla_affiliate"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

</odoo>
