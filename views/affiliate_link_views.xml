<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_affiliate_link_tree" model="ir.ui.view">
        <field name="name">cybervilla.affiliate.link.tree</field>
        <field name="model">cybervilla.affiliate.link</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code"/>
                <field name="affiliate_id"/>
                <field name="label"/>
                <field name="markup_percent"/>
                <field name="product_tmpl_id"/>
                <field name="click_count"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_affiliate_link_form" model="ir.ui.view">
        <field name="name">cybervilla.affiliate.link.form</field>
        <field name="model">cybervilla.affiliate.link</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="code"/>
                        <h1><field name="code" placeholder="e.g. TOMIWA-IP15"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="affiliate_id"/>
                            <field name="label"/>
                            <field name="backend_ref"/>
                        </group>
                        <group>
                            <field name="markup_percent"/>
                            <field name="product_tmpl_id"/>
                            <field name="pricelist_id" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <p class="text-muted">
                        The pricelist is created and kept in step by the module.
                        Do not edit it by hand — change the markup here instead.
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_affiliate_link" model="ir.actions.act_window">
        <field name="name">Affiliate Links</field>
        <field name="res_model">cybervilla.affiliate.link</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
