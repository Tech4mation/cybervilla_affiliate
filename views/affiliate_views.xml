<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_affiliate_tree" model="ir.ui.view">
        <field name="name">cybervilla.affiliate.tree</field>
        <field name="model">cybervilla.affiliate</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="backend_ref"/>
                <field name="email"/>
                <field name="link_count"/>
                <field name="order_count"/>
            </tree>
        </field>
    </record>

    <record id="view_affiliate_form" model="ir.ui.view">
        <field name="name">cybervilla.affiliate.form</field>
        <field name="model">cybervilla.affiliate</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Affiliate name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="backend_ref"/>
                            <field name="email"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Links" name="links">
                            <field name="link_ids">
                                <tree>
                                    <field name="code"/>
                                    <field name="label"/>
                                    <field name="markup_percent"/>
                                    <field name="click_count"/>
                                    <field name="active"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_affiliate" model="ir.actions.act_window">
        <field name="name">Affiliates</field>
        <field name="res_model">cybervilla.affiliate</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
